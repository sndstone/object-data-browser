{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Object Data Browser Engine Contract",
  "type": "object",
  "required": [
    "requestId",
    "method",
    "engineVersion"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "health",
        "getCapabilities",
        "testProfile",
        "listBuckets",
        "createBucket",
        "deleteBucket",
        "setBucketVersioning",
        "putBucketLifecycle",
        "deleteBucketLifecycle",
        "putBucketPolicy",
        "deleteBucketPolicy",
        "putBucketCors",
        "deleteBucketCors",
        "putBucketEncryption",
        "deleteBucketEncryption",
        "putBucketTagging",
        "deleteBucketTagging",
        "listObjects",
        "getBucketAdminState",
        "listObjectVersions",
        "getObjectDetails",
        "startUpload",
        "startDownload",
        "pauseTransfer",
        "resumeTransfer",
        "cancelTransfer",
        "deleteObjects",
        "deleteObjectVersions",
        "copyObject",
        "moveObject",
        "createFolder",
        "generatePresignedUrl",
        "runPutTestData",
        "runDeleteAll",
        "cancelToolExecution",
        "startBenchmark",
        "getBenchmarkStatus",
        "pauseBenchmark",
        "resumeBenchmark",
        "stopBenchmark",
        "exportBenchmarkResults",
        "storageAction",
        "s3ConformanceOp"
      ]
    },
    "engineVersion": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "$defs": {
    "storageAction": {
      "type": "object",
      "required": [
        "profile",
        "action"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "profile": {
          "type": "object"
        },
        "sourceProfile": {
          "type": "object"
        },
        "destinationProfile": {
          "type": "object"
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflictPolicy": {
          "enum": [
            "replace",
            "skip",
            "fail"
          ]
        }
      }
    },
    "objectEncryption": {
      "description": "Optional per-request object encryption. See transport_contract.md, Object encryption.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "bucketDefault",
            "sse-s3",
            "sse-kms",
            "dsse-kms",
            "sse-c",
            "azure-scope",
            "azure-cpk"
          ]
        },
        "kmsKeyId": {
          "type": "string"
        },
        "kmsEncryptionContext": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bucketKeyEnabled": {
          "type": "boolean"
        },
        "customerKey": {
          "type": "string",
          "description": "Base64 of exactly 32 bytes. Secret; never logged or persisted."
        },
        "encryptionScope": {
          "type": "string"
        }
      }
    },
    "clientEncryption": {
      "description": "Optional client-side (age v1) encryption for one file. See transport_contract.md, Client-side encryption.",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "format",
        "fileKey"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "age-v1"
        },
        "header": {
          "type": "string",
          "description": "Upload only. Base64 of the complete age header."
        },
        "payloadNonce": {
          "type": "string",
          "description": "Upload only. Base64 of 16 bytes."
        },
        "headerLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "description": "Download only."
        },
        "fileKey": {
          "type": "string",
          "description": "Base64 of the 16-byte age file key. Secret; never logged or persisted."
        }
      }
    },
    "s3ConformanceOp": {
      "description": "Desktop only. One S3 API operation executed through the engine SDK. See transport_contract.md, S3 API conformance.",
      "type": "object",
      "required": [
        "profile",
        "op"
      ],
      "properties": {
        "profile": {
          "type": "object"
        },
        "op": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "body": {
          "type": "object",
          "properties": {
            "generate": {
              "type": "object",
              "required": [
                "size",
                "seed"
              ],
              "properties": {
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777216
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            },
            "base64": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "encryption": {
          "$ref": "#/$defs/objectEncryption"
        },
        "sourceEncryption": {
          "$ref": "#/$defs/objectEncryption"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "storageAction"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/storageAction"
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "startUpload",
              "createFolder",
              "runPutTestData",
              "copyObject",
              "moveObject",
              "startDownload",
              "getObjectDetails",
              "generatePresignedUrl"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "encryption": {
                "$ref": "#/$defs/objectEncryption"
              },
              "sourceEncryption": {
                "$ref": "#/$defs/objectEncryption"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "startUpload",
              "startDownload"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "clientEncryption": {
                "$ref": "#/$defs/clientEncryption"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "s3ConformanceOp"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/s3ConformanceOp"
          }
        },
        "required": [
          "params"
        ]
      }
    }
  ]
}
