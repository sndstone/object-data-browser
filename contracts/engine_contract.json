{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Object Data Browser Engine Contract",
  "type": "object",
  "required": [
    "requestId",
    "method",
    "engineVersion"
  ],
  "properties": {
    "requestId": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "health",
        "getCapabilities",
        "testProfile",
        "listBuckets",
        "createBucket",
        "deleteBucket",
        "setBucketVersioning",
        "putBucketLifecycle",
        "deleteBucketLifecycle",
        "putBucketPolicy",
        "deleteBucketPolicy",
        "putBucketCors",
        "deleteBucketCors",
        "putBucketEncryption",
        "deleteBucketEncryption",
        "putBucketTagging",
        "deleteBucketTagging",
        "listObjects",
        "getBucketAdminState",
        "listObjectVersions",
        "getObjectDetails",
        "startUpload",
        "startDownload",
        "pauseTransfer",
        "resumeTransfer",
        "cancelTransfer",
        "deleteObjects",
        "deleteObjectVersions",
        "copyObject",
        "moveObject",
        "createFolder",
        "generatePresignedUrl",
        "runPutTestData",
        "runDeleteAll",
        "cancelToolExecution",
        "startBenchmark",
        "getBenchmarkStatus",
        "pauseBenchmark",
        "resumeBenchmark",
        "stopBenchmark",
        "exportBenchmarkResults",
        "storageAction"
      ]
    },
    "engineVersion": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  },
  "$defs": {
    "storageAction": {
      "type": "object",
      "required": [
        "profile",
        "action"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "profile": {
          "type": "object"
        },
        "sourceProfile": {
          "type": "object"
        },
        "destinationProfile": {
          "type": "object"
        },
        "versionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflictPolicy": {
          "enum": [
            "replace",
            "skip",
            "fail"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "storageAction"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "#/$defs/storageAction"
          }
        },
        "required": [
          "params"
        ]
      }
    }
  ]
}
